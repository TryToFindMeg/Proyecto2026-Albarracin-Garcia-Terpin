{
    "name": "retrowave-react",
    "private": true,
    "version": "0.1.0",
    "description": "RetroWave: tienda en React para la segunda entrega.",
    "type": "module",
    "engines": {
        "node": "^22.13.0 || >=24.0.0"
    },
    "scripts": {
        "dev": "vite --host 127.0.0.1",
        "build": "vite build && node scripts/preparar-publicacion.js",
        "preview": "vite preview --host 127.0.0.1",
        "services": "json-server src/data/db.json --host 127.0.0.1 --port 4000",
        "lint": "eslint . --max-warnings 0",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "check:datos": "node scripts/verificar-datos.js",
        "check": "npm run lint && npm run format:check && npm run build"
    },
    "dependencies": {
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "react-router-dom": "7.18.5"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@vitejs/plugin-react": "6.2.1",
        "eslint": "10.14.0",
        "eslint-plugin-react-hooks": "7.1.1",
        "eslint-plugin-react-refresh": "0.5.7",
        "globals": "17.14.0",
        "json-server": "1.0.0-beta.15",
        "prettier": "3.9.10",
        "sass": "1.107.1",
        "vite": "8.3.5"
    },
    "overrides": {
        "eslint": {
            "minimatch": "11.0.1"
        },
        "@eslint/config-array": {
            "minimatch": "11.0.1"
        }
    }
}
